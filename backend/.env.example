# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://microflow:microflow_secret@localhost:5432/microflow

# CORS — comma-separated list of allowed origins as a JSON array string
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# AI — Google Gemini API key (required for AI Run Review)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
